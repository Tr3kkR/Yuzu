[
    {yuzu_gw, [
        %% Agent-facing gRPC listen address (agents connect here)
        {agent_listen_addr, "0.0.0.0"},
        {agent_listen_port, 50051},

        %% Operator-facing gRPC listen address (dashboard/CLI connects here)
        {mgmt_listen_addr, "0.0.0.0"},
        {mgmt_listen_port, 50063},

        %% Upstream C++ yuzu-server address (GatewayUpstream service port)
        %% Server must be started with --gateway-upstream "addr:port" matching this.
        {upstream_addr, "127.0.0.1"},
        {upstream_port, 50055},

        %% Upstream connection pool size
        {upstream_pool_size, 32},

        %% Heartbeat batching interval (ms) — 1s gives ~0.5s avg latency
        {heartbeat_batch_interval_ms, 1000},

        %% Default command timeout (seconds)
        {default_command_timeout_s, 300},

        %% Prometheus metrics HTTP port
        {prometheus_port, 9568},

        %% Health/readiness HTTP port
        {health_port, 8081},

        %% Agent telemetry gauge emission interval (ms)
        {telemetry_gauge_interval_ms, 10000},

        %% Circuit breaker settings (upstream connection protection)
        {circuit_breaker_failure_threshold, 5},
        {circuit_breaker_reset_timeout_ms, 10000},
        {circuit_breaker_max_reset_timeout_ms, 300000},

        %% Stream backpressure threshold (message queue length)
        {backpressure_threshold, 1000},

        %% TLS master switch. Set to false to force plaintext even if certs
        %% are configured (useful for local testing). Default: auto (TLS used
        %% when tls config is present, plaintext otherwise).
        %% Override: YUZU_GW_TLS_ENABLED=false
        %% {tls_enabled, false},

        %% TLS configuration (optional — omit for plaintext)
        %% {tls, [
        %%     {certfile, "/etc/yuzu/gateway.crt"},
        %%     {keyfile,  "/etc/yuzu/gateway.key"},
        %%     {cacertfile, "/etc/yuzu/ca.crt"},
        %%     {verify, verify_peer},
        %%     {fail_if_no_peer_cert, true}
        %% ]},

        %% Consistent hash ring: virtual nodes per physical node
        {hash_ring_vnodes, 256},

        %% HA WS-4 4.1 — the trust-zone/region cluster id this gateway belongs
        %% to; agents are pinned to one cluster (ADR-2002 §7). Stamped onto
        %% every StreamStatusNotification sent upstream so the server's
        %% routing directory can record which cluster owns an agent's live
        %% stream. A single-cluster deployment can leave this at its stable
        %% default. Override: YUZU_GW_CLUSTER_ID
        {cluster_id, <<"default">>},

        %% HA WS-4 #4555 — gateway multi-node cluster FORMATION (ADR-2002 §7b),
        %% distinct from `cluster_id` above: this is what to RESOLVE to find
        %% peer addresses, not the logical cluster identifier. Default
        %% `"gateway"` matches the reference Compose service name, so a scaled
        %% `docker compose up --scale gateway=N` needs zero extra config.
        %% Override: YUZU_GW_SEED_DNS_NAME.
        {cluster_seed_dns_name, <<"gateway">>},

        %% An explicit comma-separated peer address list. When set (non-empty),
        %% REPLACES DNS resolution outright — never merged with it — so a
        %% leftover test override cannot silently coexist with a working DNS
        %% setup. Covers air-gapped / no-DNS / hand-pinned-IPs deployments.
        %% Override: YUZU_GW_SEED_NODES (e.g. "10.0.0.1,10.0.0.2").
        {cluster_seed_nodes, []},

        %% Always-on redial loop interval (ms) — fixed, no backoff (matches
        %% this codebase's other retry idioms). `connect_all` is `false`
        %% below, so nothing else in the VM ever auto-meshes a partial
        %% connection set; this loop is what forms AND maintains the mesh.
        %% Override: YUZU_GW_CLUSTER_REDIAL_INTERVAL_MS.
        {cluster_redial_interval_ms, 5000}
    ]},

    {grpcbox, [
        {client, #{channels => [
            %% default_channel: upstream C++ yuzu-server (GatewayUpstream service)
            %% Port must match --gateway-upstream flag on the server.
            {default_channel, [{http, "127.0.0.1", 50055, []}], #{}}
        ]}},
        {servers, [
            %% Agent-facing service (agents connect here)
            #{grpc_opts => #{
                service_protos => [agent_pb],
                services => #{'yuzu.agent.v1.AgentService' => yuzu_gw_agent_service}
            },
            listen_opts => #{port => 50051, ip => {0,0,0,0}}},
            %% Operator-facing service (dashboard/CLI connects here). DEV config:
            %% plaintext + unauthenticated, but bound to 127.0.0.1 ONLY so it is not
            %% network-reachable. The PRODUCTION posture (strict mTLS on a 0.0.0.0
            %% mgmt plane, #1314) is in sys.config.prod / reference-gateway-sys.config
            %% — do NOT copy this localhost-plaintext listener into a deployment.
            #{grpc_opts => #{
                service_protos => [management_pb],
                services => #{'yuzu.server.v1.ManagementService' => yuzu_gw_mgmt_service}
            },
            listen_opts => #{port => 50063, ip => {127,0,0,1}}}
        ]}
    ]},

    {kernel, [
        {connect_all, false},
        {net_ticktime, 30},
        %% HA WS-4 #4555: pin a small distribution port range so it can
        %% actually be firewalled — unset, OTP picks a random ephemeral port
        %% per boot, which is unfirewallable on a bare-VM deployment. One
        %% container per node (the primary deployment target) only ever needs
        %% one port each, but a small range instead of a single exact port
        %% leaves headroom for a multiple-nodes-on-one-host dev/test rig.
        %% Document this range alongside the existing mgmt-plane (:50063) and
        %% agent-edge (:50051) firewall guidance. epmd itself (:4369) is
        %% unaffected.
        {inet_dist_listen_min, 9100},
        {inet_dist_listen_max, 9105},
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", pid, " ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
