#!/bin/bash
# Yuzu Agent macOS post-install script
# Runs as root after pkgbuild installs files.

set -e

DATA_DIR="/Library/Application Support/Yuzu"
LOG_DIR="/Library/Logs/Yuzu"
PLIST="/Library/LaunchDaemons/com.yuzu.agent.plist"

# Create directories
mkdir -p "${DATA_DIR}" "${LOG_DIR}"
chmod 750 "${DATA_DIR}"
chmod 755 "${LOG_DIR}"

# Trust-anchor directory for OTA update signature verification (#416/#3807).
# Its OWN directory, NOT /etc/yuzu/certs: that path is the server's --ca-dir,
# which the server owns and re-chmods 0700 on boot, so an anchor there is either
# unwritable by the server or unreadable by the agent. NOTE the LaunchDaemon runs
# as root, so the agent CAN write this - the mode keeps unprivileged local users
# out, not the agent itself. See "Signing update binaries" in
# docs/user-manual/server-admin.md.
mkdir -p /etc/yuzu-agent/certs
chown root:wheel /etc/yuzu-agent /etc/yuzu-agent/certs
chmod 755 /etc/yuzu-agent /etc/yuzu-agent/certs

# Load the launch daemon (starts the agent)
if launchctl list com.yuzu.agent &>/dev/null; then
    launchctl unload "${PLIST}" 2>/dev/null || true
fi
launchctl load -w "${PLIST}"

echo "Yuzu Agent installed and started."
echo "  Data:    ${DATA_DIR}"
echo "  Logs:    ${LOG_DIR}"
echo "  Service: launchctl list com.yuzu.agent"
exit 0
