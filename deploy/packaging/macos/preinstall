#!/bin/bash
# Yuzu Agent macOS pre-install script
# Stops the existing agent if upgrading, and removes retired plugins.

set -e

PLIST="/Library/LaunchDaemons/com.yuzu.agent.plist"
PLUGIN_DIR="/usr/local/lib/yuzu/plugins"

if [ -f "${PLIST}" ] && launchctl list com.yuzu.agent &>/dev/null; then
    echo "Stopping existing Yuzu Agent..."
    launchctl unload "${PLIST}" 2>/dev/null || true
    sleep 2
fi

# ── Retired plugins ──────────────────────────────────────────────────────
# Retired plugins must be deleted explicitly on upgrade. pkgbuild/Installer.app
# only lay down the current payload; a plugin dropped from a later release is
# never pruned from a previous install. That matters because the agent's plugin
# loader walks this directory with recursive_directory_iterator and loads EVERY
# .dylib it finds — allowlist enforcement is off unless an operator configures
# --plugin-allowlist — so a leftover file keeps loading a retired plugin.
#
# Linux .deb/.rpm need no equivalent (dpkg/rpm own the installed file list and
# drop what leaves it); the Windows installer does the same job via the
# [InstallDelete] section in deploy/packaging/windows/yuzu-agent.iss.
#
# APPEND the basename of each retired plugin here as it is retired; never
# remove an entry, so upgrades from any older release stay covered.
RETIRED_PLUGINS=(
    "vuln_scan"   # retired outright, ADR-0018 / ADR-0028 Decision 2
)

# Matched RECURSIVELY and by name, deliberately: the loader's walk is recursive, so
# a retired plugin is loadable from a subdirectory too, and a future entry in the
# list above may not sit flat in PLUGIN_DIR. Matching only the flat path would make
# this sweep narrower than the hazard it exists to close. `find -delete` also removes
# a dangling symlink, which a `[ -e ]` guard would skip (it follows the link).
if [ -d "${PLUGIN_DIR}" ]; then
    for name in "${RETIRED_PLUGINS[@]}"; do
        while IFS= read -r stale; do
            [ -n "${stale}" ] || continue
            if rm -f "${stale}"; then
                echo "Removed retired plugin: ${stale}"
            else
                # Non-fatal: never abort an upgrade over this. But it MUST be visible —
                # a silent failure leaves a loadable retired plugin while the install log
                # and docs/user-manual/upgrading.md both assert it was removed.
                echo "WARNING: failed to remove retired plugin: ${stale}" >&2
                echo "WARNING: remove it manually before starting the agent." >&2
            fi
        done < <(find "${PLUGIN_DIR}" -name "${name}.dylib" 2>/dev/null || true)
    done
fi

exit 0
