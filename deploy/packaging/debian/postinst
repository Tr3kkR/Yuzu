#!/bin/bash
set -e

# Shared postinst for yuzu-server and yuzu-agent packages.
# Called with package name via dpkg trigger or directly.

COMPONENT="${DPKG_MAINTSCRIPT_PACKAGE:-yuzu-server}"

case "$1" in
    configure)
        if [[ "$COMPONENT" == "yuzu-server" ]]; then
            SVC_USER="yuzu"
            SVC_NAME="yuzu-server"
            DATA_DIR="/var/lib/yuzu"
        else
            SVC_USER="yuzu-agent"
            SVC_NAME="yuzu-agent"
            DATA_DIR="/var/lib/yuzu-agent"
        fi

        # Create system user
        if ! getent passwd "$SVC_USER" >/dev/null 2>&1; then
            adduser --system --group --home "$DATA_DIR" --no-create-home --shell /usr/sbin/nologin "$SVC_USER"
        fi

        # Create directories
        install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" "$DATA_DIR"
        install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" /var/log/yuzu

        # Trust-anchor directory for OTA update signature verification
        # (#416/#3807). Its OWN directory, deliberately not /etc/yuzu/certs:
        # that path is the SERVER's --ca-dir (auth.cpp), owned and written by the
        # yuzu user, and default_certs.cpp re-chmods it 0700 on every boot. An
        # anchor placed there is either unwritable by the server (breaking CA
        # creation) or unreadable by the agent (breaking every signed update),
        # depending on who owns it — there is no mode that satisfies both.
        #
        # root-owned: on Linux the agent runs unprivileged, so it genuinely
        # cannot rewrite the anchor that authorises its own updates.
        install -d -m 0755 -o root -g root /etc/yuzu-agent
        install -d -m 0755 -o root -g root /etc/yuzu-agent/certs

        if [[ "$COMPONENT" == "yuzu-server" ]]; then
            SVC_USER="yuzu"
            SVC_NAME="yuzu-server"
            DATA_DIR="/var/lib/yuzu"
        else
            SVC_USER="yuzu-agent"
            SVC_NAME="yuzu-agent"
            DATA_DIR="/var/lib/yuzu-agent"
        fi

        # Create system user
        if ! getent passwd "$SVC_USER" >/dev/null 2>&1; then
            adduser --system --group --home "$DATA_DIR" --no-create-home --shell /usr/sbin/nologin "$SVC_USER"
        fi

        # Create directories
        install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" "$DATA_DIR"
        install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" /var/log/yuzu

        # Trust-anchor directory for OTA update and plugin code-signing bundles
        # (#416/#3807). ROOT-owned, deliberately NOT owned by the service user:
        # on Linux the agent runs unprivileged, so it genuinely cannot rewrite
        # the anchor that authorises its own updates.
        #
        # /etc/yuzu used to be created 0750 yuzu:yuzu by the SERVER branch below.
        # On a host carrying both packages the agent user could then not even
        # traverse into its own certs directory, and every SIGNED package would
        # be refused with "trust bundle unreadable" — a failure whose cause is
        # nowhere near its symptom. So the parent is created traversable here;
        # 0755 on a directory holding only public trust anchors and config
        # discloses nothing, and the server branch's own 0750 files keep their
        # modes regardless of the directory bit.
        install -d -m 0755 -o root -g root /etc/yuzu
        install -d -m 0755 -o root -g root /etc/yuzu/certs

        if [[ "$COMPONENT" == "yuzu-server" ]]; then
            install -d -m 0750 -o "$SVC_USER" -g "$SVC_USER" /etc/yuzu

            # Postgres provisioning (ADR-0006, #1320). NON-FATAL by design:
            # the helper exits 0 with install hints when no local cluster is
            # found, and any other failure must not break package configure
            # while the server still boots without Postgres (until the #1320
            # PR 3 fail-closed flip; re-evaluate this guard then).
            if [[ -x /usr/share/yuzu/scripts/install-server-postgres.sh ]]; then
                bash /usr/share/yuzu/scripts/install-server-postgres.sh || \
                    echo "warn: Postgres provisioning incomplete — re-run /usr/share/yuzu/scripts/install-server-postgres.sh (see docs/user-manual/server-admin.md)" >&2
            fi
        fi

        # Update shared library cache (agent ships libyuzu_agent_core.so)
        if [[ "$COMPONENT" == "yuzu-agent" ]]; then
            ldconfig || true
        fi

        # Enable systemd service
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable "${SVC_NAME}.service" || true
            echo "$SVC_NAME installed. Start with: systemctl start $SVC_NAME"
        fi
        ;;
esac

exit 0
