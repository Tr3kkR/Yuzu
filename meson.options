option('build_agent',    type: 'boolean', value: true,  description: 'Build the agent daemon')
option('build_server',   type: 'boolean', value: true,  description: 'Build the server daemon')
option('build_examples', type: 'boolean', value: true,  description: 'Build the demo example plugins (example, chargen, procfetch, netprobe) -- every other plugin builds regardless of this flag')
option('build_tests',    type: 'boolean', value: false, description: 'Build unit and integration tests')
option('build_fuzzers',  type: 'boolean', value: false,
       description: 'Build the libFuzzer harnesses in tests/fuzz/ (requires clang; '
                  + 'links -fsanitize=fuzzer,address,undefined). Mirrored by '
                  + '.clusterfuzzlite/build.sh for CI fuzzing.')
option('systemd_guard',  type: 'feature', value: 'enabled',
       description: 'Linux libsystemd integration: systemd service guard, Service spark mechanism '
                  + '(sd-bus), and the event_logs sd_journal native leg (sd-journal). '
                  + 'enabled (default): require libsystemd so the shipped agent always offers all. '
                  + 'auto: use libsystemd if present, else build no-op stubs / argv fallbacks. '
                  + 'disabled: always stub. '
                  + 'Use auto/disabled for musl/Alpine/minimal images without libsystemd.')
option('enable_enterprise', type: 'boolean', value: false,
       description: 'Build commercial enterprise modules from enterprise/. '
                  + 'Requires a commercial license — see enterprise/LICENSE-ENTERPRISE.md. '
                  + 'OSS AGPL builds MUST leave this off.')
option('require_gateway', type: 'boolean', value: false,
       description: 'Fail configure when rebar3 (the Erlang gateway toolchain) is not '
                  + 'found, instead of silently skipping the gateway build and its '
                  + 'eunit/ct tests. For local fresh setups: CI instead asserts the gateway '
                  + 'tests were registered (scripts/ci/assert-gateway-tests.py), because a '
                  + 'non-default option stored in a persistent CI build dir breaks '
                  + 'reconfigures from older branches (#4841).')
# Sanitizers, LTO: use Meson built-ins instead of custom options:
#   -Db_lto=true                       Link-time optimisation
#   -Db_sanitize=address,undefined     AddressSanitizer + UBSan
#   -Db_sanitize=thread                ThreadSanitizer
