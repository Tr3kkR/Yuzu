# Build artifacts
builddir/
vcpkg_installed/
*.exe
*.dll
*.pdb
*.obj

# Git / CI
.git/
.github/

# Claude Code
.claude/

# Documentation (not needed in build context)
*.md
docs/

# Tests (excluded from production builds)
tests/
# …except the libFuzzer harnesses + seed corpora: .clusterfuzzlite/Dockerfile
# does `COPY . $SRC/Yuzu`, and the blanket tests/ exclusion silently emptied
# the fuzz build (CFLite run 28711283993: "no such file …/tests/fuzz/…").
# A few KB of context for the production image builds is the whole cost.
!tests/fuzz
!tests/fuzz/**

# Node / Puppeteer
node_modules/

# Gateway build artifacts
gateway/_build/
gateway/.deps_cache/
gateway/ebin/
gateway/erl_crash.dump
gateway/rebar3.crashdump
gateway/test_ebin/

# UAT / test artifacts
.uat/
test_output.txt
test_xml.txt
Synthetic-UAT-Puppeteer.js

# Deploy configs (not source code)
deploy/docker/docker-compose*.yml
